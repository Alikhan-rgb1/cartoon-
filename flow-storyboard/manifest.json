{
  "manifest_version": 3,
  "name": "Flow Storyboard Auto",
  "version": "0.1.0",
  "description": "Автоматическая генерация кадров раскадровки в Google Flow по сценарию и персонажам.",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "downloads", "activeTab", "scripting", "tabs", "debugger"],
  "host_permissions": ["https://flow.google.com/*", "https://flow-content.google/*", "https://generativelanguage.googleapis.com/*", "https://gemini.google.com/*"],
  "action": { "default_title": "Flow Storyboard Auto" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
